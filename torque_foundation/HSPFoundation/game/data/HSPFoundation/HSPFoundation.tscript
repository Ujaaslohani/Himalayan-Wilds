if (!isObject(HSPFoundationTerrainGrassMaterial))
{
   new TerrainMaterial(HSPFoundationTerrainGrassMaterial)
   {
      internalName = "HSPFoundationTerrainGrass";
      diffuseMapAsset = "HSPFoundation:HSPFoundationTerrainGrass_ALBEDO";
      diffuseSize = "80";
      detailSize = "8";
      useSideProjection = "1";
   };
}

if (!isObject(HSPFoundationTerrainGrassRenderMaterial))
{
   new Material(HSPFoundationTerrainGrassRenderMaterial)
   {
      mapTo = "HSPFoundationTerrainGrass";
      diffuseMapAsset[0] = "HSPFoundation:HSPFoundationTerrainGrass_ALBEDO";
      terrainMaterials = "1";
      materialTag0 = "Terrain";
   };
}

if (!isObject(HSPFoundationPrototypeBlueMaterial))
{
   new Material(HSPFoundationPrototypeBlueMaterial)
   {
      mapTo = "blue";
      diffuseColor[0] = "0 0.48 0.95 1";
      emissive[0] = "1";
   };
}

if (!isObject(HSPFoundationPrototypeDefaultMaterial))
{
   new Material(HSPFoundationPrototypeDefaultMaterial)
   {
      mapTo = "DefaultMaterial";
      diffuseColor[0] = "0.7 0.7 0.7 1";
   };
}

function HSPFoundation::onCreate(%this)
{
   echo("HSPFoundation module created");
}

function HSPFoundation::onDestroy(%this)
{
}

function HSPFoundation::initServer(%this)
{
   HSP_prepareFoundationTerrainAsset();
   %this.queueExec("./scripts/shared/HSPFoundationGameMode");
}

function HSPFoundation::onCreateGameServer(%this)
{
   %this.registerDatablock("./scripts/server/HSPFoundationDatablocks");
}

function HSPFoundation::onServerScriptExec(%this)
{
   HSP_prepareFoundationForestAsset();
}

function HSPFoundation::initClient(%this)
{
   HSP_prepareFoundationTerrainAsset();
   %this.queueExec("./scripts/client/HSPFoundationHud");
   %this.queueExec("./scripts/shared/HSPFoundationGameMode");
   schedule(250, 0, HSPFoundationAutoStart);
}

function HSPFoundation::onCreateClientConnection(%this)
{
   ExampleMovemap.push();
}

function HSPFoundationAutoStart()
{
   if ($HSPFoundation::Started)
      return;

   $HSPFoundation::Started = true;
   StartGame("HSPFoundation:HSPFoundationLevel", "SinglePlayer");
}
