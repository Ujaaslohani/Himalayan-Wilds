if (!isObject(HSPFoundationGameMode))
{
   new GameMode(HSPFoundationGameMode)
   {
      alwaysActive = "1";
   };
}

function HSPFoundationGameMode::onMissionStart(%this)
{
   echo("HSPFoundationGameMode: mission start");
   HSP_logFoundationFeaturePolicy();
   HSP_runFoundationDiagnostics("server-mission-start");
   %animal = HSP_spawnFoundationAnimal();
   if (%animal > 0)
      schedule(100, 0, HSPFoundationAnimalTick);
}

function HSPFoundationGameMode::onClientEnterGame(%this, %client)
{
   commandToClient(%client, 'SyncClock', $Sim::Time - %this.StartTime);
   %client.setPlayerName(%client.connectData);
   echo("HSPFoundationGameMode: client enter; standard Torque spawn pipeline will create validation player");
}

function HSPFoundationGameMode::setSpawnObjectType(%this, %client)
{
   echo("HSPFoundationGameMode: assigning Player datablock");
   %client.spawnClass = "HSPValidationPlayer";
   %client.spawnDBType = "PlayerData";
   %client.spawnDataBlock = "HSPValidationPlayerData";
   %client.GetEventManager().postEvent("setSpawnObjectTypeComplete", %client);
}

function HSPFoundationGameMode::setSpawnPoint(%this, %client)
{
   %spawnX = -120;
   %spawnY = -110;
   %height = HSP_getFoundationTerrainHeight(%spawnX, %spawnY);
   echo("HSPFoundationGameMode: player spawn height" SPC %height);
   %client.spawnLocation = %spawnX SPC %spawnY SPC (%height + 2.0);
   %client.spawnRotation = "0 0 1 0.65";
   %client.GetEventManager().postEvent("setSpawnPointComplete", %client);
}

function HSPFoundationGameMode::onInitialControlSet(%this)
{
   if (isObject(ServerConnection))
   {
      ServerConnection.clearCameraObject();
      ServerConnection.setFirstPerson(true);
   }

   HSP_bindFoundationPrototypeControls();
   echo("HSPFoundationGameMode: initial player control set");
   schedule(500, 0, HSP_runFoundationDiagnostics, "client-post-ghost");
}

function HSPFoundationGameMode::onMissionEnded(%this)
{
}

function HSP_bindFoundationPrototypeControls()
{
   if (isObject(ExampleMoveMap))
      ExampleMoveMap.bindCmd(mouse, button0, "HSP_foundationPrototypeShoot();", "");
}

function HSP_foundationPrototypeShoot()
{
   commandToServer('HSPFoundationShoot');
}

function serverCmdHSPFoundationShoot(%client)
{
   if (!isObject(%client) || !isObject(%client.player))
      return;

   HSP_foundationHuntRay(%client.player.getId());
}

function HSPFoundationAnimalTick()
{
   if (HSP_tickFoundationAnimal(0.1))
      schedule(100, 0, HSPFoundationAnimalTick);
}
