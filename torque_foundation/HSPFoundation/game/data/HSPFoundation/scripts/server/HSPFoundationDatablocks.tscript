function HSPFoundationDeerData::onReachDestination(%this, %obj)
{
   if (isObject(%obj))
   {
      HSP_setFoundationAnimalState("grazing");
      schedule(2400, 0, HSP_moveFoundationAnimal, %obj.getId());
   }
}

function HSPFoundationDeerData::onMoveStuck(%this, %obj)
{
   if (isObject(%obj))
   {
      HSP_snapObjectToFoundationTerrain(%obj.getId(), 1.0);
      schedule(1000, 0, HSP_moveFoundationAnimal, %obj.getId());
   }
}
